/* link.ld - Bare-Metal Linker Script tracking Multiboot alignments */
ENTRY(_start)

SECTIONS {
    /* Bootloader standards specify alignment boundaries starting at 1 Megabyte marker */
    . = 1M;

    .text BLOCK(4K) : ALIGN(4K) {
        *(.multiboot)
        *(.text)
    }

    .rodata BLOCK(4K) : ALIGN(4K) {
        *(.rodata)
    }

    .data BLOCK(4K) : ALIGN(4K) {
        *(.data)
    }

    .bss BLOCK(4K) : ALIGN(4K) {
        *(COMMON)
        *(.bss)
    }
}
